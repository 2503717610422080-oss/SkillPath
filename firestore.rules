rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles: read by any authenticated user, written only by the owner
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Target roles: user specific
    match /targetRoles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User skills: user specific
    match /userSkills/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Assessments: authenticated users can record and read assessments
    match /assessments/{assessmentId} {
      allow read, write: if isAuthenticated();
    }

    // Learning plans: user specific
    match /learningPlans/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Projects: user specific
    match /projects/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Resumes: user specific
    match /resumes/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Mock interview sessions
    match /interviewSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback: any other collection protected by authentication
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
